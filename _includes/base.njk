<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ metaTitle or pageTitle }}</title>

  {% if metaDescription or description %}
  <meta name="description" content="{{ metaDescription or description }}">
  {% endif %}

  {% if canonical %}
  <link rel="canonical" href="{{ canonical }}">
  {% endif %}

  <meta property="og:type" content="{{ ogType or 'article' }}">
  <meta property="og:title" content="{{ metaTitle or pageTitle }}">
  <meta property="og:description" content="{{ metaDescription or description }}">
  {% if ogImage %}
  <meta property="og:image" content="{{ ogImage }}">
  {% endif %}

  {% if date %}
  <meta property="article:published_time" content="{{ date }}">
  {% endif %}
  {% if updated %}
  <meta property="article:modified_time" content="{{ updated }}">
  {% endif %}

  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,600&display=swap" rel="stylesheet">

  {% if schema and schema.type == "ScholarlyArticle" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ScholarlyArticle",
    "headline": "{{ title.article }}",
    "author": {
      "@type": "Person",
      "name": "{{ author }}"
    },
    "description": "{{ abstract or description }}",
    "isAccessibleForFree": true
  }
  </script>
  {% endif %}
</head>
<body>
  <div class="container">
    <header>
      {% if showHomeLink !== false %}
        <nav class="back-home">
        <a href="/">← Back to home</a>
        </nav>
      {% endif %}
      <h1 class="title">
        {% if title.article %}
        “{{ title.article }}”
        {% endif %}

        {% if title.book %}
        <span class="book-title">{{ title.book }}</span>
        {% endif %}

        {% if title.year %}
        <span class="year">({{ title.year }})</span>
        {% endif %}
      </h1>

      {% if author %}
      <p class="author">{{ author }}</p>
      {% endif %}

      {% if abstract %}
      <p class="abstract">{{ abstract }}</p>
      {% endif %}

    </header>

    <main class="site-main {{ section }}">
      {{ content | safe }}
      <!-- Buy Me a Coffee button -->
      {% if showCoffee !== false %}
  <div class="bmc-button">
    <a href="https://www.buymeacoffee.com/alittlesense" target="_blank" rel="noopener">
      <img src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
     alt="Buy Me a Coffee"
     style="width: 100%; max-width: 178px; height: auto;">
    </a>
  </div>
  {% endif %}
      {% if showHomeLink !== false %}
        <nav class="back-home">
        <a href="/">← Back to home</a>
        </nav>
      {% endif %}
    </main>

    <footer>
  <p>
    This work is licensed under
    <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/">CC BY-NC-ND 4.0</a>
  </p>
  <p>
     2026 A Little Sense
  </p>
</footer>
  </div>
</body>
</html>
